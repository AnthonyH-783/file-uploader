<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <title>File Uploader</title>
</head>
<body>
    <%-include("components/navbar", {selected})%>
    <% if(selected === 'upload'){ %>
            <%-include("components/upload-form", {categories})%>
    <% } else if(selected === 'folders') { %>
            <%-include("components/folders-list", {folders}) %>
    <% } else { %>
        <%-include("pages/error", {status:401, message: 'Page not found'})%>
    <% } %>



</body>
</html>