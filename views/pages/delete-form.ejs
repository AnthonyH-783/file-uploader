<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete <%= docType %></title>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="stylesheet" href="/stylesheets/pages/delete-form.css">
</head>
<body class="delete-page">
    <form class="delete-form" action="/<%= docType %>s/<%= docId %>/delete" method="post">

        <header class="delete-form__header">
            <div class="delete-form__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            </div>
            <div>
                <h1 class="delete-form__title">Delete <%= docType %></h1>
                <p class="delete-form__subtitle">This action can't be undone.</p>
            </div>
        </header>

        <div class="delete-form__body">
            <p class="delete-form__question">
                Are you sure you want to delete this <%= docType %>?
            </p>

            <div class="delete-form__preview">
                <% if (docType === "folder") { %>
                    <div class="delete-form__folder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                    </div>
                <% } else if (mediaType === "image") { %>
                    <img class="delete-form__media" src="<%= url %>" alt="<%= docName %>">
                <% } else if (mediaType === "video") { %>
                    <video class="delete-form__media" controls>
                        <source src="<%= url %>" type="<%= mimeType %>">
                        <a href="<%= url %>">Open the video</a>
                    </video>
                <% } else if (mediaSubtype === "pdf") { %>
                    <object class="delete-form__pdf" data="<%= url %>" type="<%= mimeType %>">
                        <p class="delete-form__fallback">
                            Your browser can't show PDFs inline. <a href="<%= url %>">Open the PDF</a>
                        </p>
                    </object>
                <% } else if (mediaType === "audio") { %>
                    <audio class="delete-form__audio" controls>
                        <source src="<%= url %>" type="<%= mimeType %>">
                        <a href="<%= url %>">Open the audio file</a>
                    </audio>
                <% } else { %>
                    <p class="delete-form__fallback">
                        No preview available. <a href="<%= url %>">Open the file</a>
                    </p>
                <% } %>
            </div>

            <div class="delete-form__name">
                <span class="delete-form__name-label"><%= docType %> name</span>
                <span class="delete-form__name-value"><%= docName %></span>
            </div>

            <% if (docType === "folder") { %>
                <div class="delete-form__warning" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <span>Everything inside this folder will be deleted too.</span>
                </div>
            <% } %>
        </div>

        <footer class="delete-form__actions">
            <a class="delete-form__btn delete-form__btn--secondary" href="<%= backLink %>">Cancel</a>
            <button class="delete-form__btn delete-form__btn--danger" type="submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                Delete <%= docType %>
            </button>
        </footer>
    </form>
</body>
</html>