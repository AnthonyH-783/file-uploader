<form class="sign-in-form" action="/auth/login" method="POST">

    <h1 class="sign-in-form__title">Sign in</h1>

    <div class="sign-in-form__group">
      <label class="sign-in-form__label" for="username">Email</label>
      <input
        class="sign-in-form__input"
        type="email"
        id="email"
        name="email"
        required
      />
    </div>

    <div class="sign-in-form__group">
      <label class="sign-in-form__label" for="password">Password</label>
      <input
        class="sign-in-form__input"
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        required
      />
    </div>

    <button class="sign-in-form__button" type="submit">Sign in</button>
    <a href="/auth/signup">Don't have an account ? Sign up</a>
  </form>