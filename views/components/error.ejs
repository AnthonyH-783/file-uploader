<!-- Expected in res.locals: formErrors (string[]) -->
<% const errors = locals.formErrors ?? []; %>
<% if (errors.length > 0) { %>
<div class="form-error" role="alert" aria-live="assertive">
    <svg class="form-error__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>

    <div class="form-error__content">
        <p class="form-error__title">
            Please fix the following <%= errors.length === 1 ? "error" : `${errors.length} errors` %>
        </p>
        <ul class="form-error__list">
            <% for (const errorMsg of errors) { %>
                <li><%= errorMsg %></li>
            <% } %>
        </ul>
    </div>
</div>
<% } %>